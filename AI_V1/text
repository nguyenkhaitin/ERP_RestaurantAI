class TableManager:
    def __init__(self, table_id, max_capacity):
        self.id = table_id
        self.max_capacity = max_capacity
        self.status = "TRONG" 
        self.occupied_start_time = None
        self.dwell_time = 0
        self.current_headcount = 0
        self.headcount_history = deque(maxlen=90)
        self.entry_start_check = None
        self.empty_start_check = None

    def update(self, raw_headcount):
        # OCCLUSION BONUS
        final_count = raw_headcount
        if self.id in [1, 4]: 
            if raw_headcount >= 4: final_count += 1 
            if raw_headcount >= 8: final_count += 1
        final_count = min(final_count, self.max_capacity)

        self.headcount_history.append(final_count)
        
        # SMOOTHING
        if self.headcount_history:
            history_list = list(self.headcount_history)
            if len(history_list) < 10:
                smooth_headcount = max(history_list)
            else:
                smooth_headcount = int(np.percentile(history_list, 90))
        else:
            smooth_headcount = 0
            
        self.current_headcount = smooth_headcount
        has_people_stable = smooth_headcount > 0

        # REAL-TIME LOGIC
        if has_people_stable:
            if self.entry_start_check is None:
                self.entry_start_check = time.time()
            self.empty_start_check = None
        else:
            if self.empty_start_check is None:
                self.empty_start_check = time.time()
            if time.time() - self.empty_start_check > 3.0:
                self.entry_start_check = None

        # ENTRY LOGIC
        if self.status == "TRONG" and self.entry_start_check is not None:
            duration_present = time.time() - self.entry_start_check
            required_seconds = 5.0 
            
            if self.max_capacity >= 10:
                if smooth_headcount <= 2: required_seconds = 20.0 
                else: required_seconds = 5.0 
            elif self.id == 7: required_seconds = 20.0
            elif self.id in [5, 6]:
                if smooth_headcount < 2: required_seconds = 25.0
                else: required_seconds = 7.0

            if duration_present > required_seconds:
                self.status = "CO KHACH"
                self.occupied_start_time = time.time()
        
        # EXIT LOGIC
        elif self.status == "CO KHACH":
            session_time = 0
            if self.occupied_start_time:
                session_time = time.time() - self.occupied_start_time

            is_empty_now = False
            if len(self.headcount_history) >= 20:
                if max(list(self.headcount_history)[-20:]) == 0:
                    is_empty_now = True
            
            if is_empty_now:
                self.reset_table()
                return

            if self.empty_start_check is not None:
                duration_empty = time.time() - self.empty_start_check
                if duration_empty > 45.0:
                    self.reset_table()

        if self.status == "CO KHACH" and self.occupied_start_time:
            self.dwell_time = int(time.time() - self.occupied_start_time)

    def reset_table(self):
        self.status = "TRONG"
        self.occupied_start_time = None
        self.dwell_time = 0
        self.current_headcount = 0
        self.entry_start_check = None

    def get_info(self):
        mins, secs = divmod(self.dwell_time, 60)
        time_str = f"{mins:02d}:{secs:02d}"
        pos_status = SIMULATED_POS_DATA.get(self.id, 'CLOSED')
        
        alert_type = "NONE"
        if self.status == "CO KHACH" and pos_status == "CLOSED": alert_type = "KHACH AO"
        elif self.status == "TRONG" and pos_status == "OPEN": alert_type = "QUEN DONG"
        if mins > 60: alert_type = "NGOI LAU"
        
        return {
            'id': self.id + 1, 'status': self.status, 'time_str': time_str, 
            'seconds': self.dwell_time, 
            'headcount': self.current_headcount, 'capacity': self.max_capacity, 'alert': alert_type
        }

def ai_worker():
    global processed_data, is_running, dashboard_data
    print("🚀 AI Started (V27: B2 Torso Checkpoint 0.45)")
    table_managers = [TableManager(i, TABLE_CAPACITIES[i]) for i in range(len(table_polygons))]
    model = YOLO(MODEL_PATH) 
    
    track_history = {} 

    while is_running:
        if current_frame is None: time.sleep(0.01); continue
        
        with lock: frame_to_process = current_frame.copy()
        
        target_w, target_h = 960, 540 
        scale_w = 1920 / target_w
        scale_h = 1080 / target_h
        frame_small = cv2.resize(frame_to_process, (target_w, target_h))
        
        results = model.track(frame_small, persist=True, verbose=False, classes=[0], 
                              conf=0.20, iou=0.65, tracker="bytetrack.yaml")
        
        temp_boxes = []
        people_count_at_table = {i: 0 for i in range(len(table_polygons))}
        total_guests = 0
        
        if results[0].boxes.id is not None:
            boxes = results[0].boxes.xyxy.cpu().numpy().astype(int)
            track_ids = results[0].boxes.id.cpu().numpy().astype(int)

            for box, track_id in zip(boxes, track_ids):
                x1, y1 = int(box[0] * scale_w), int(box[1] * scale_h)
                x2, y2 = int(box[2] * scale_w), int(box[3] * scale_h)
                
                center_x, center_y = int((x1+x2)/2), int((y1+y2)/2)
                
                speed = 0
                if track_id in track_history:
                    prev_x, prev_y = track_history[track_id]
                    speed = math.sqrt((center_x - prev_x)**2 + (center_y - prev_y)**2)
                track_history[track_id] = (center_x, center_y)

                in_table = False
                for i, poly in enumerate(table_polygons):
                    # Velocity Filter
                    if i in STRICT_TABLES and speed > WALKING_THRESHOLD:
                        continue 

                    # CHECKPOINT RATIO (B2 = 0.45)
                    ratio = CHECK_POINT_RATIOS.get(i, 0.75)
                    
                    check_y = int(y1 + (y2 - y1) * ratio)
                    check_point = (int((x1+x2)/2), check_y)

                    if cv2.pointPolygonTest(poly, check_point, False) >= 0:
                        people_count_at_table[i] += 1
                        in_table = True
                        break 
                
                if in_table:
                    color = (0, 255, 255)
                    total_guests += 1
                elif speed > WALKING_THRESHOLD:
                    color = (50, 50, 50) 
                else:
                    color = (100, 100, 100)

                temp_boxes.append((x1, y1, x2, y2, color)) 
                
        busy_tables, total_dwell_time, table_details, active_alerts = 0, 0, [], []
        temp_visuals = []
        
        for i, poly in enumerate(table_polygons):
            manager = table_managers[i]
            manager.update(people_count_at_table[i])
            info = manager.get_info()
            table_details.append(info)
            
            if info['status'] == "CO KHACH":
                busy_tables += 1
                total_dwell_time += info['seconds']
                poly_color = (0, 0, 200) 
                if info['alert'] == "KHACH AO": poly_color = (0, 0, 139) 
            else:
                poly_color = (0, 200, 0)
                if info['alert'] == "QUEN DONG": poly_color = (0, 215, 255)
            
            label = f"B{info['id']}"
            if info['status'] == "CO KHACH": 
                label += f"({info['headcount']}/{info['capacity']})"
            
            cx, cy = int(np.mean(poly[:,0])), int(np.mean(poly[:,1]))
            offset_x, offset_y = TEXT_OFFSETS.get(i, (0, 0))
            final_cx = cx + offset_x
            final_cy = cy + offset_y

            temp_visuals.append((poly, poly_color, label, (final_cx, final_cy)))
            
            if info['alert'] == "KHACH AO": active_alerts.append(f"B{info['id']}: KHACH AO")
            if info['alert'] == "QUEN DONG": active_alerts.append(f"B{info['id']}: QUEN DONG POS")
            if info['alert'] == "NGOI LAU": active_alerts.append(f"B{info['id']}: >60 phut")

        occupancy_rate = int((busy_tables / len(table_polygons)) * 100)
        avg_dwell = int(total_dwell_time / busy_tables // 60) if busy_tables > 0 else 0
        
        dashboard_data = {'occupancy_rate': occupancy_rate, 'total_guests': total_guests, 'avg_dwell_time': avg_dwell, 'table_details': table_details, 'alerts': active_alerts}
        processed_data = {'boxes': temp_boxes, 'visuals': temp_visuals}

def create_combined_dashboard(video_frame, data):
    display_h = 576
    display_w = 1024
